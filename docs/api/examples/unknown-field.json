{
  "name": "unknown field is rejected",
  "request": {
    "method": "POST",
    "path": "/api/v1/calculations",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "operation": "add",
      "operands": [
        1,
        2
      ],
      "precision": 2
    }
  },
  "response": {
    "status": 400,
    "contentType": "application/problem+json",
    "body": {
      "type": "about:blank",
      "title": "Bad Request",
      "status": 400,
      "detail": "Request body must be a single JSON object with only the fields \"operation\" and \"operands\".",
      "code": "INVALID_JSON"
    }
  }
}

{
  "name": "operand count must match the arity",
  "request": {
    "method": "POST",
    "path": "/api/v1/calculations",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "operation": "add",
      "operands": [
        1
      ]
    }
  },
  "response": {
    "status": 400,
    "contentType": "application/problem+json",
    "body": {
      "type": "about:blank",
      "title": "Bad Request",
      "status": 400,
      "detail": "Operation \"add\" requires exactly 2 operands.",
      "code": "INVALID_OPERANDS"
    }
  }
}

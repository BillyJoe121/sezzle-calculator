{
  "name": "subtract returns a minus b",
  "request": {
    "method": "POST",
    "path": "/api/v1/calculations",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "operation": "subtract",
      "operands": [
        10,
        4.5
      ]
    }
  },
  "response": {
    "status": 200,
    "contentType": "application/json",
    "body": {
      "operation": "subtract",
      "operands": [
        10,
        4.5
      ],
      "result": 5.5
    }
  }
}
